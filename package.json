{
  "name": "btbn-web-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build-secrets.mjs",
    "lint": "oxlint src worker tests scripts",
    "preview": "npm run build && wrangler dev",
    "test": "playwright test",
    "sync:demos": "node scripts/sync-demos.mjs",
    "capture:previews": "node scripts/capture-previews.mjs",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply btbn-portfolio-prod --local",
    "db:seed:local": "wrangler d1 migrations apply btbn-portfolio-prod --local",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "db:studio:local": "wrangler d1 execute btbn-portfolio-prod --local --command \"SELECT id, slug, title, is_published, featured, sort_order FROM projects ORDER BY sort_order\"",
    "seed:generate": "node scripts/generate-seed.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.57.1",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.1"
  }
}
